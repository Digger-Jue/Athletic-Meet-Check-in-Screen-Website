<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>陈蓉评价 - 北京育才学校陈蓉办公室</title>
    <style>
        /* ================= 基础重置 ================= */
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { 
            font-family: "Microsoft YaHei", "PingFang SC", sans-serif; 
            background-color: #f5f6f8; 
            color: #000000; /* 全局纯黑字体 */
            line-height: 1.8; 
            font-size: 15px;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }
        ul { list-style: none; }
        a { text-decoration: none; color: inherit; }
        
        /* ================= 配色变量 ================= */
        :root {
            --official-red: #b71c1c;      
            --official-red-hover: #8e1414;
            --border-color: #e0e0e0;
            --bg-white: #ffffff;
            --container-width: 1200px;
        }

        .container { max-width: var(--container-width); margin: 0 auto; padding: 0 20px; width: 100%; }

        /* ================= 顶部工具栏 (Top Bar) ================= */
        .top-bar { background-color: #2c3e50; color: #ffffff; font-size: 12px; padding: 8px 0; }
        .top-bar .container { display: flex; justify-content: space-between; align-items: center; }
        .top-links a { color: #ffffff; margin-left: 15px; cursor: pointer; }
        .top-links a:hover { text-decoration: underline; }

        /* ================= 头部 Logo 区 ================= */
        .main-header { background-color: var(--bg-white); padding: 30px 0; text-align: center; border-bottom: 1px solid var(--border-color); }
        .calligraphy-logo { max-width: 550px; height: auto; display: block; margin: 0 auto; }

        /* ================= 主导航栏 (Navbar) ================= */
        .main-nav { background-color: var(--official-red); }
        .main-nav ul { display: flex; justify-content: center; }
        .main-nav li { position: relative; }
        .main-nav a { display: block; color: #ffffff; padding: 15px 35px; font-size: 16px; cursor: pointer; }
        .main-nav a:hover, .main-nav a.active { background-color: var(--official-red-hover); }

        /* ================= 主体内容区 (纯文本排版) ================= */
        main { flex: 1; background-color: var(--bg-white); padding: 60px 0; }
        
        .article-container {
            max-width: 800px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* 正文文本样式，纯黑无特效，增加首行缩进 */
        .article-text {
            font-size: 18px;
            color: #000000;
            text-align: left;
            line-height: 2;
            margin-bottom: 30px;
            text-indent: 2em; /* 首行缩进两个字符 */
        }

        /* 图片居中，无任何修饰 */
        .article-image {
            display: block;
            max-width: 100%;
            height: auto;
            max-height: 500px;
            object-fit: contain;
            margin: 0 auto 10px auto; /* 底部间距调小，给图片说明留空间 */
        }

        /* 图片说明样式（灰色小字） */
        .image-caption {
            font-size: 14px;
            color: #888888;
            text-align: center;
            margin-bottom: 30px; /* 图片说明与下一段文字保持距离 */
            line-height: 1.5;
        }

        /* ================= 底部区域 (Footer) ================= */
        .footer-top { background-color: #2c3e50; color: #ffffff; padding: 40px 0; font-size: 13px; }
        .footer-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 30px; }
        .footer-grid h3 { color: #ffffff; font-size: 16px; margin-bottom: 20px; border-bottom: 1px solid #444; padding-bottom: 10px; }
        .footer-grid ul li { margin-bottom: 10px; }
        .footer-grid a { cursor: pointer; color: #ffffff; }
        .footer-grid a:hover { text-decoration: underline; }
        
        .footer-bottom { background-color: #1a252f; color: #ffffff; text-align: center; padding: 20px 0; font-size: 12px; }
        .footer-bottom p { margin-bottom: 5px; }

        /* ================= 错误提示弹窗 ================= */
        .modal-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background-color: rgba(0, 0, 0, 0.5);
            display: flex; justify-content: center; align-items: center;
            z-index: 9999; opacity: 0; visibility: hidden;
        }
        .modal-overlay.show { opacity: 1; visibility: visible; }
        .modal-box {
            background: #ffffff; border-radius: 4px; width: 90%; max-width: 400px;
            padding: 30px 20px; text-align: center; border: 1px solid #000000;
        }
        .modal-box h3 { font-size: 22px; color: #000000; margin-bottom: 15px; }
        .modal-box p { font-size: 14px; color: #000000; margin-bottom: 25px; }
        .modal-btn {
            background-color: #ffffff; color: #000000; border: 1px solid #000000;
            padding: 8px 25px; font-size: 14px; cursor: pointer;
        }
        .modal-btn:hover { background-color: #000000; color: #ffffff; }

        /* ================= 响应式设计 ================= */
        @media (max-width: 992px) {
            .footer-grid { grid-template-columns: 1fr 1fr; }
        }
        @media (max-width: 768px) {
            .top-bar .container { flex-direction: column; gap: 10px; }
            .calligraphy-logo { max-width: 90%; }
            .main-nav ul { flex-wrap: wrap; }
            .main-nav a { padding: 12px 20px; font-size: 14px; }
            .footer-grid { grid-template-columns: 1fr; }
            main { padding: 30px 0; }
            .article-text { font-size: 16px; }
        }
    </style>
</head>
<body>

    <!-- 顶部工具栏 -->
    <div class="top-bar">
        <div class="container">
            <span>欢迎访问北京育才学校陈蓉办公室官方网站！</span>
            <div class="top-links">
                <a class="placeholder-link" data-error="401">设为首页</a> | 
                <a class="placeholder-link" data-error="401">加入收藏</a>
            </div>
        </div>
    </div>

    <!-- 头部 Logo 区 -->
    <header class="main-header">
        <div class="container">
            <!-- Logo 路径已修改为当前文件夹 -->
            <img src="logo.jpg" alt="北京育才学校陈蓉办公室" class="calligraphy-logo" onerror="this.style.display='none'">
        </div>
    </header>

    <!-- 主导航栏 -->
    <nav class="main-nav">
        <div class="container">
            <ul>
                <!-- 首页链接已修改为当前文件夹的 index.html -->
                <li><a href="index.html" class="active">首页</a></li>
                <li><a class="placeholder-link" data-error="404">办公室概况</a></li>
                <li><a class="placeholder-link" data-error="404">通知公告</a></li>
                <li><a class="placeholder-link" data-error="404">工作动态</a></li>
                <li><a class="placeholder-link" data-error="404">办事指南</a></li>
                <li><a class="placeholder-link" data-error="404">联系方式</a></li>
            </ul>
        </div>
    </nav>

    <!-- 主体内容区 -->
    <main>
        <div class="article-container">
            
            <!-- 图片前面的文字（已应用首行缩进） -->
            <p class="article-text">在今年的运动会中，贺梓衿参加了男子甲组800米预决赛。</p>
            
            <!-- 图片 -->
            <img src="hzj.png" alt="贺梓衿" class="article-image" onerror="this.src='data:image/svg+xml;base64,'">
            
            <!-- 图片下方的灰色小字 -->
            <p class="image-caption">供图：陈蓉</p>
            
            <!-- 图片后面的评价（已应用首行缩进） -->
            <p class="article-text">
                陈蓉评价：贺梓衿强强强强
            </p>
            
        </div>
    </main>

    <!-- 底部区域 -->
    <footer>
        <div class="footer-top">
            <div class="container footer-grid">
                <div>
                    <h3>关于我们</h3>
                    <ul>
                        <li><a class="placeholder-link" data-error="404">办公室简介</a></li>
                        <li><a class="placeholder-link" data-error="404">主要职责</a></li>
                        <li><a class="placeholder-link" data-error="404">工作团队</a></li>
                    </ul>
                </div>
                <div>
                    <h3>快速导航</h3>
                    <ul>
                        <li><a class="placeholder-link" data-error="404">通知公告</a></li>
                        <li><a class="placeholder-link" data-error="404">工作动态</a></li>
                        <li><a class="placeholder-link" data-error="404">办事指南</a></li>
                    </ul>
                </div>
                <div>
                    <h3>友情链接</h3>
                    <ul>
                        <li><a class="placeholder-link" data-error="404">北京育才学校官网</a></li>
                        <li><a class="placeholder-link" data-error="404">北京市教育委员会</a></li>
                        <li><a class="placeholder-link" data-error="404">中国教育部</a></li>
                    </ul>
                </div>
            </div>
        </div>
        <div class="footer-bottom">
            <div class="container">
                <p>&copy; 2024 北京育才学校陈蓉办公室 版权所有. All Rights Reserved.</p>
                <p>地址：北京市西城区（示例） | 电话：010-XXXXXXXX | <a class="placeholder-link" data-error="404" style="display:inline; color: inherit; cursor:pointer;">京ICP备XXXXXXXX号-1</a></p>
            </div>
        </div>
    </footer>

    <!-- 404/401 错误提示弹窗结构 -->
    <div id="error-modal" class="modal-overlay">
        <div class="modal-box">
            <h3 id="modal-title">404 Not Found</h3>
            <p id="modal-msg">抱歉，该页面正在建设中或暂时无法访问。</p>
            <button id="modal-close" class="modal-btn">确定</button>
        </div>
    </div>

    <!-- 页面交互脚本 -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const modal = document.getElementById('error-modal');
            const modalTitle = document.getElementById('modal-title');
            const modalMsg = document.getElementById('modal-msg');
            const closeBtn = document.getElementById('modal-close');

            document.querySelectorAll('.placeholder-link').forEach(link => {
                link.addEventListener('click', function(e) {
                    e.preventDefault(); 
                    const errorCode = this.getAttribute('data-error') || '404';
                    
                    if (errorCode === '401') {
                        modalTitle.innerText = '401 Unauthorized';
                        modalMsg.innerText = '您没有权限执行此操作或访问该资源。';
                    } else {
                        modalTitle.innerText = '404 Not Found';
                        modalMsg.innerText = '抱歉，该页面正在开发中或您访问的链接不存在。';
                    }
                    
                    modal.classList.add('show');
                });
            });

            const closeModal = () => { modal.classList.remove('show'); };
            closeBtn.addEventListener('click', closeModal);
            modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
        });
    </script>
</body>
</html>
